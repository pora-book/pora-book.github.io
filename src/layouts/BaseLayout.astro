---
import '../styles/global.css';
import { GOATCOUNTER } from '../data/analytics.js';
const { title, description, active } = Astro.props;
const pageTitle = title ? `${title} · Principles of Robot Autonomy` : 'Principles of Robot Autonomy';
const nav = [
  { href: '/book/', label: 'The Book', key: 'book' },
  { href: '/exercises/', label: 'Exercises', key: 'exercises' },
  { href: '/lectures/', label: 'Lectures', key: 'lectures' },
  { href: '/instructors/', label: 'For Instructors', key: 'instructors' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <div class="inner">
        <a class="brand" href="/">
          <span class="title">Principles of Robot Autonomy</span>
        </a>
        <nav>
          {nav.map((n) => (
            <a href={n.href} class={active === n.key ? 'active' : ''}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="inner">
        <div>
          <div style="font-weight:600;color:var(--ink-soft)">Principles of Robot Autonomy</div>
          <div>Gammelli · Lorenzetti · Luo · Zardini · Pavone</div>
        </div>
      </div>
    </footer>

    {/* Cookieless pageview + outbound-click counting. Renders only once a
        GoatCounter endpoint is set in src/data/analytics.js. */}
    {GOATCOUNTER && (
      <script data-goatcounter={GOATCOUNTER} async src="https://gc.zgo.at/count.js"></script>
    )}
  </body>
</html>
