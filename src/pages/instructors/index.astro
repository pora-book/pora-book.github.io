---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COURSES } from '../../data/slides.js';

// Slides follow the lecture order of the Stanford courses (src/data/slides.js),
// not the book's chapter order. PDF/PPTX links point into public/slides/…;
// a link only renders once the file actually exists in the repo, so PPTX
// links light up automatically as the source files are added.
const publicDir = path.join(process.cwd(), 'public');
const available = (href) => fs.existsSync(path.join(publicDir, href));
const partLabel = (kind, hrefs, i) =>
  hrefs.length > 1 ? `${kind} · Part ${i + 1}` : kind;

// Resources credited in the lecture slides themselves — courses and books that
// shaped how we present the material. Keep in sync with the slide decks.
const ackCourses = [
  { name: 'UC Berkeley CS 185/285 — Deep Reinforcement Learning',
    url: 'https://rail.eecs.berkeley.edu/deeprlcourse/' },
  { name: 'Stanford CS 224R — Deep Reinforcement Learning',
    url: 'https://cs224r.stanford.edu/' },
  { name: 'Stanford CS 231n — Deep Learning for Computer Vision',
    url: 'http://cs231n.stanford.edu/' },
  { name: 'Sanja Fidler’s computer vision lectures (University of Toronto)',
    url: 'https://www.cs.toronto.edu/~fidler/' },
];
const ackBooks = [
  { name: 'D. E. Kirk, Optimal Control Theory: An Introduction' },
  { name: 'F. Borrelli, A. Bemporad, M. Morari, Predictive Control for Linear and Hybrid Systems' },
  { name: 'J. B. Rawlings, D. Q. Mayne, M. M. Diehl, Model Predictive Control: Theory, Computation, and Design' },
  { name: 'R. S. Sutton, A. G. Barto, Reinforcement Learning: An Introduction' },
  { name: 'J.-J. E. Slotine, W. Li, Applied Nonlinear Control' },
  { name: 'S. M. LaValle, Planning Algorithms' },
  { name: 'R. Siegwart, I. R. Nourbakhsh, D. Scaramuzza, Introduction to Autonomous Mobile Robots' },
  { name: 'D. A. Forsyth, J. Ponce, Computer Vision: A Modern Approach' },
  { name: 'R. Hartley, A. Zisserman, Multiple View Geometry in Computer Vision' },
  { name: 'R. M. Murray, Optimization-Based Control (lecture notes)' },
];
---
<BaseLayout
  title="For Instructors"
  active="instructors"
  description="Resources for professors, lecturers, and instructors building a course around Principles of Robot Autonomy: lecture slides, reference syllabi, and assessment materials."
>
  <div class="prose-wrap" style="padding-top:2.5rem">
    <h1 style="font-size:2.2rem;margin:1rem 0 0.5rem">For Instructors</h1>
    <p style="color:var(--muted);max-width:104ch">
      <em>Principles of Robot Autonomy</em> is designed to be taught. Whether you are running a full
      semester-long robotics course or folding a few chapters into an existing class, this page gathers
      everything you need to build your own course on top of the book.
    </p>

    <section class="instr-section">
      <h2>Build your course</h2>
      <p>
        The book grew out of a decade of teaching at Stanford and the chapters map directly onto these courses, which you can use as reference syllabi,
        pacing guides, and sources of additional class materials:
      </p>
      {/* Same card treatment as the Lectures page; both courses are live, so
          neither carries a "coming soon" state. */}
      <div class="course-cards">
        {COURSES.map((course) => (
          <a class="course-card" href={course.url} target="_blank" rel="noopener">
            <img class="course-mark" src="/logos/stanford.svg" alt="" width="162" height="248" loading="lazy" />
            <span class="course-card-body">
              <span class="course-code">{course.code}</span>
              <span class="course-name">{course.title}</span>
              <span class="course-status">Course website <span class="course-arrow">↗</span></span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="instr-section">
      <h2>Lecture slides</h2>
      <p>
        The book's chapters are accompanied by lecture slides in PDF and PPTX formats. The slides are organized by course and lecture, and you can download them for use in your own classes.
      </p>

      {COURSES.map((course) => (
        <div class="slides-course">
          <h3 class="slides-course-title">
            <span class="slides-course-code">{course.code}</span>
            {course.title}
          </h3>
          <div class="chapter-list">
            {course.lectures.map((lec) => (
              <div class="chapter-row" style="cursor:default">
                <span class="num">{lec.n}</span>
                <span class="name">{lec.title}</span>
                <span class="tags">
                  {lec.pdf.map((href, i) =>
                    available(href)
                      ? <a class="tag-ex" href={href} target="_blank" rel="noopener">{partLabel('PDF', lec.pdf, i)}</a>
                      : <span class="tag-soon">{partLabel('PDF', lec.pdf, i)} soon</span>,
                  )}
                  {lec.pptx.map((href, i) =>
                    <span class="tag-soon">{partLabel('PPTX', lec.pptx, i)} coming soon</span>,
                  )}
                </span>
              </div>
            ))}
          </div>
        </div>
      ))}
    </section>

    <section class="instr-section">
      <h2>Exams, homeworks &amp; solutions</h2>
      <p>
        To preserve their value as assessments, exams, homework sets, and their solutions are shared
        privately with instructors rather than posted publicly. If you are teaching a course and would
        like access, please feel free to contact us.
      </p>
    </section>

    <section class="instr-section">
      <h2>Adopting the book</h2>
      <p>
       We look forward to seeing <em>Principles of Robot Autonomy</em> in your course! If you are adopting the book, please reach out and let us know. We would love to hear about your experience, and we can also help publicize your course on this website.
      </p>
    </section>

    <section class="instr-section">
      <h2>Acknowledgments</h2>
      <p>
        Our beliefs about robot autonomy, and the way we present the material in the book and in
        these slides, have been largely informed by other excellent courses, textbooks, and lecture
        materials from across the community. We are deeply grateful to their authors and instructors.
        If you are building a course, the resources below are wonderful companions to this book.
      </p>
      <div class="ack-groups">
        <div>
          <h3 class="ack-heading">Courses &amp; lecture materials</h3>
          <ul class="ack-list">
            {ackCourses.map((r) => (
              <li>
                {r.url
                  ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
                  : r.name}
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="ack-heading">Textbooks &amp; notes</h3>
          <ul class="ack-list">
            {ackBooks.map((r) => (
              <li>
                {r.url
                  ? <a href={r.url} target="_blank" rel="noopener">{r.name}</a>
                  : r.name}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p>
      </p>
      <p class="instr-fineprint">
        Individual lectures also draw on many excellent surveys and research papers, credited on the
        slides where they appear.
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .instr-section { padding: 2.75rem 0 0; }
  .instr-section h2 {
    font-size: 1.5rem; margin: 0 0 1rem;
  }
  .instr-section h2::after {
    content: ''; display: block; width: 2rem; height: 2px;
    background: var(--accent); margin-top: 0.6rem;
  }
  .instr-section p { color: var(--ink-soft); margin: 0 0 1rem; }
  .instr-fineprint { font-size: 0.9rem; color: var(--muted); margin-top: 1rem; }

  .slides-course { margin-top: 1.75rem; }
  .slides-course-title {
    font-family: var(--serif); font-size: 1.15rem; color: var(--ink);
    margin: 0 0 0.75rem; display: flex; align-items: baseline; gap: 0.6rem;
    flex-wrap: wrap;
  }
  .slides-course-code {
    font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--accent); font-weight: 600;
  }

  .ack-groups {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: 1.5rem 2.5rem; margin-top: 1.25rem;
  }
  .ack-heading {
    font-family: var(--sans); font-size: 0.72rem; letter-spacing: 0.05em;
    text-transform: uppercase; color: var(--accent); font-weight: 600;
    margin: 0 0 0.6rem;
  }
  .ack-list {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0.45rem;
    font-family: var(--serif); font-size: 0.98rem; color: var(--ink-soft);
  }
  .ack-list li { padding-left: 1rem; position: relative; }
  .ack-list li::before {
    content: '—'; position: absolute; left: 0; color: var(--accent);
    font-size: 0.8rem; top: 0.15rem;
  }

  /* Course cards — mirrors .lec-course-card on the Lectures page. */
  .course-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(21rem, 1fr));
    gap: 1.25rem; margin-top: 1.25rem;
  }
  .course-card {
    display: flex; align-items: center; gap: 1.1rem;
    padding: 1.4rem 1.45rem; border-radius: 12px;
    border: 1px solid var(--line-strong); background: var(--paper-2);
    font-family: var(--sans); color: var(--ink);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .course-card:hover {
    text-decoration: none; border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 24px -16px rgba(20, 30, 50, 0.45);
  }
  .course-mark { height: 2.9rem; width: auto; flex: none; }
  .course-card-body { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .course-code {
    font-size: 0.72rem; letter-spacing: 0.05em; text-transform: uppercase;
    color: var(--accent); font-weight: 600;
  }
  /* This page's column is 52rem (vs 72rem on Lectures), so the two cards are
     narrower and these titles wrap — balance them so no orphan word is left. */
  .course-name {
    font-family: var(--serif); font-size: 1.15rem; line-height: 1.25; color: var(--ink);
    text-wrap: balance;
  }
  .course-status {
    display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;
    font-size: 0.85rem; color: var(--muted); margin-top: 0.35rem;
  }
  .course-arrow { color: var(--accent); }
  .course-meta { font-size: 0.82rem; color: var(--muted); margin-top: 0.1rem; }

  @media (max-width: 62rem) {
    .course-cards { grid-template-columns: 1fr; }
  }
</style>
