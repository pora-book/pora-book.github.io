---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { publishedChapters, displayNumber } from '../../data/book.js';
import exercises from '../../data/exercises.json';

const withExercises = publishedChapters().filter((c) => c.exercises && exercises[c.exercises]?.length);
const total = withExercises.reduce((n, c) => n + exercises[c.exercises].length, 0);
---
<BaseLayout title="Exercises" active="exercises" description="Interactive Jupyter notebooks for Principles of Robot Autonomy.">
  <div class="prose-wrap" style="padding-top:2.5rem">
    <span class="chip">Practice</span>
    <h1 style="font-size:2.2rem;margin:1rem 0 0.5rem">Exercises</h1>
    <p style="color:var(--muted);max-width:52ch">
      {total} interactive notebooks across {withExercises.length} chapters. Each opens
      directly in Google Colab, or view the source in the
      <a href="https://github.com/StanfordASL/pora-exercises">pora-exercises</a> repository.
    </p>
    <p style="color:var(--muted);max-width:52ch;font-size:0.92rem">
      To run locally: clone the repo and create the environment with
      <code>conda env create -f environment.yml</code>, then <code>conda activate pora</code>.
    </p>

    {withExercises.map((c) => (
      <>
        <div class="part-head">Chapter {displayNumber(c)} · {c.title}</div>
        <div class="rail" style="margin:0.75rem 0 0;background:transparent;border:none;padding:0">
          <ul>
            {exercises[c.exercises].map((nb) => (
              <li>
                <span class="nb-name">{nb.name}</span>
                <span class="nb-links">
                  <a href={nb.colab} target="_blank" rel="noopener">Open in Colab</a>
                  <a href={nb.source} target="_blank" rel="noopener">Source</a>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </>
    ))}
  </div>
</BaseLayout>
